#!/usr/bin/env bash
# Codex Bark Monitor wrapper: one entry point for the containerized stack.
# All docker compose calls run from the repo root with the repo .env, so
# interpolation (BARK_ENDPOINT, tokens, CBM_*) resolves consistently.
set -euo pipefail
cd "$(dirname "$0")"

# `-f` disables compose's automatic override merge, so load it explicitly.
COMPOSE_ARGS=(--env-file .env)
if [ -f deploy/docker/docker-compose.override.yml ]; then
  COMPOSE_ARGS=(-f deploy/docker/docker-compose.yml -f deploy/docker/docker-compose.override.yml "${COMPOSE_ARGS[@]}")
else
  COMPOSE_ARGS=(-f deploy/docker/docker-compose.yml "${COMPOSE_ARGS[@]}")
fi

case "${1:-}" in
  up)    exec docker compose "${COMPOSE_ARGS[@]}" up -d --build ;;
  down)  exec docker compose "${COMPOSE_ARGS[@]}" down ;;
  logs)  exec docker compose "${COMPOSE_ARGS[@]}" logs -f agent-notify ;;
  install-host)   shift; exec node host/install-host.mjs "$@" ;;
  uninstall-host) shift; exec node host/uninstall-host.mjs "$@" ;;
  *)     exec docker compose "${COMPOSE_ARGS[@]}" exec -T agent-notify node dist/cli/index.js "$@" ;;
esac
